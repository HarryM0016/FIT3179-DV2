{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Graduate Median Salary Gap by Field, 2025",
    "anchor": "start"
  },
  "width": 187,
  "data": {
    "url": "https://raw.githubusercontent.com/HarryM0016/FIT3179-DV2/refs/heads/main/charts/median_salary_vs_gender/Gender_median_salary_2025.csv"
  },
  "params": [{ "name": "fieldFilter", "value": "All" }],
  "transform": [
    {
      "calculate": "datum.Gap > 0 ? 'Male higher' : 'Female higher'",
      "as": "Gap direction"
    }
  ],
  "layer": [
    {
      "mark": { "type": "rule", "strokeWidth": 3 },
      "encoding": {
        "x": { "field": "Gap", "type": "quantitative" },
        "x2": { "datum": 0 },
        "y": {
          "field": "Field",
          "type": "nominal",
          "title": null
        },
        "opacity": {
          "condition": {
            "test": "fieldFilter === 'All' || datum.Field === fieldFilter",
            "value": 1
          },
          "value": 0.15
        },
        "color": {
          "field": "Gap direction",
          "type": "nominal",
          "title": "Higher Median Salary",
          "scale": {
            "domain": ["Male higher", "Female higher"],
            "range": ["#2F4A6B", "#8095AE"]
          }
        }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 110 },
      "encoding": {
        "x": {
          "field": "Gap",
          "type": "quantitative",
          "title": "Salary gap",
          "scale": { "domain": [-6000, 6000] },
          "axis": {
            "values": [-6000, -4000, -2000, 0, 2000, 4000, 6000],
            "format": "$,.0f"
          }
        },
        "y": {
          "field": "Field",
          "type": "nominal",
          "sort": [
            "Business and management",
            "Engineering",
            "Health",
            "Society and Culture",
            "Information Technology",
            "Education",
            "Creative Arts",
            "Natural and Physical Sciences"
          ],
          "axis": {
            "title": null,
            "labelLineHeight": 8,
            "labelOffset": -2,
            "labelLimit": 0,
            "labelExpr": "{'Business and management': ['Business and','management'], 'Society and Culture': ['Society and','Culture'], 'Information Technology': ['Information','Technology'], 'Natural and Physical Sciences': ['Natural and','Physical Sciences']}[datum.label] || datum.label"
          }
        },
        "color": {
          "field": "Gap direction",
          "type": "nominal",
          "scale": {
            "domain": ["Male higher", "Female higher"],
            "range": ["#4C78A8", "#E45756"]
          }
        },
        "tooltip": [
          { "field": "Field", "type": "nominal", "title": "Field" },
          {
            "field": "Female",
            "type": "quantitative",
            "title": "Female median salary",
            "format": "$,.0f"
          },
          {
            "field": "Male",
            "type": "quantitative",
            "title": "Male median salary",
            "format": "$,.0f"
          },
          {
            "field": "Gap",
            "type": "quantitative",
            "title": "Gap (male - female)",
            "format": "$,.0f"
          }
        ],
        "opacity": {
          "condition": {
            "test": "fieldFilter === 'All' || datum.Field === fieldFilter",
            "value": 1
          },
          "value": 0.15
        }
      }
    },
    {
      "mark": { "type": "rule", "color": "#555555", "strokeDash": [4, 4] },
      "encoding": { "x": { "datum": 0 } }
    }
  ]
}
