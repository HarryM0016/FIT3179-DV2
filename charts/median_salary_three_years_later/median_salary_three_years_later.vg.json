{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Change in Median Salary for 2022 Graduates by Field",
    "anchor": "start"
  },
  "width": 225,
  "height": 166,
  "data": {
    "url": "https://raw.githubusercontent.com/HarryM0016/FIT3179-DV2/refs/heads/main/charts/median_salary_three_years_later/Field_median_salary_2022vs2025.csv"
  },
  "params": [{ "name": "fieldFilter", "value": "All" }],
  "encoding": {
    "x": {
      "field": "Salary",
      "type": "quantitative",
      "title": "Median salary ($)",
      "axis": { "format": "$,.0f" }
    },
    "y": {
      "field": "Field",
      "type": "nominal",
      "sort": [
        "Business and management",
        "Engineering",
        "Health",
        "Society and Culture",
        "Information Technology",
        "Education",
        "Creative Arts",
        "Natural and Physical Sciences"
      ],
      "axis": {
        "title": null,
        "labelLineHeight": 8,
        "labelOffset": -2,
        "labelLimit": 0,
        "labelExpr": "{'Business and management': ['Business and','management'], 'Society and Culture': ['Society and','Culture'], 'Information Technology': ['Information','Technology'], 'Natural and Physical Sciences': ['Natural and','Physical Sciences']}[datum.label] || datum.label"
      }
    },
    "tooltip": [
      { "field": "Field", "type": "nominal", "title": "Field" },
      { "field": "Year", "type": "nominal", "title": "Year" },
      {
        "field": "Salary",
        "type": "quantitative",
        "title": "Median salary",
        "format": "$,.0f"
      }
    ],
    "opacity": {
      "condition": {
        "test": "fieldFilter === 'All' || datum.Field === fieldFilter",
        "value": 1
      },
      "value": 0.15
    }
  },
  "layer": [
    {
      "mark": { "type": "line", "color": "#777777", "strokeWidth": 2 },
      "encoding": {
        "detail": { "field": "Field", "type": "nominal" },
        "order": {
          "field": "Year",
          "type": "ordinal"
        }
      }
    },
    {
      "mark": { "type": "point", "filled": true, "size": 90 },
      "encoding": {
        "color": {
          "field": "Year",
          "type": "nominal",
          "title": "Year",
          "scale": {
            "domain": ["2022", "2025"],
            "range": ["#2F4A6B", "#8095AE"]
          },
          "legend": {
            "labelLimit": 0,
            "labelExpr": "{'2022': ['2022','graduate','in 2022'], '2025': ['2022','graduate','in 2025']}[datum.label] || datum.label"
          }
        }
      }
    }
  ]
}
