{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": {
    "text": "Commencing Undergraduate Student Counts by Field, 2015-2024",
    "anchor": "start"
  },
  "width": 212,
  "height": 214,
  "data": {
    "url": "https://raw.githubusercontent.com/HarryM0016/FIT3179-DV2/refs/heads/main/charts/1_line_chart/Commencing_Student_Counts_2015-2024.csv"
  },
  "mark": {
    "type": "line",
    "point": true
  },
  "params": [
    {
      "name": "fieldFilter",
      "value": "All"
    }
  ],
  "encoding": {
    "x": {
      "field": "Year",
      "type": "quantitative",
      "scale": {
        "domain": [2015, 2024]
      },
      "axis": {
        "title": "Year",
        "format": "d",
        "values": [2015, 2016, 2017, 2018, 2019, 2020, 2021, 2022, 2023, 2024]
      }
    },
    "y": {
      "field": "Count",
      "type": "quantitative",
      "axis": {
        "title": "Student Count"
      }
    },
    "color": {
      "field": "Field",
      "type": "nominal",
      "title": "Field",
      "legend": {
        "labelLimit": 0,
        "labelExpr": "{'Business and management': ['Business and','management'], 'Society and Culture': ['Society and','Culture'], 'Information Technology': ['Information','Technology'], 'Natural and Physical Sciences': ['Natural and','Physical Sciences']}[datum.label] || datum.label"
      },
      "scale": {
        "domain": [
          "Business and management",
          "Engineering",
          "Health",
          "Society and Culture",
          "Information Technology",
          "Education",
          "Creative Arts",
          "Natural and Physical Sciences"
        ],
        "range": [
          "#0072B2",
          "#E69F00",
          "#C23B22",
          "#CC79A7",
          "#56B4E9",
          "#009E73",
          "#7E57C2",
          "#8D6E4B"
        ]
      }
    },
    "detail": {
      "field": "Field",
      "type": "nominal"
    },
    "tooltip": [
      {
        "field": "Field",
        "type": "nominal",
        "title": "Field"
      },
      {
        "field": "Year",
        "type": "quantitative",
        "format": "d",
        "title": "Year"
      },
      {
        "field": "Count",
        "type": "quantitative",
        "format": ",",
        "title": "Students"
      }
    ],
    "opacity": {
      "condition": {
        "test": "fieldFilter === 'All' || datum.Field === fieldFilter",
        "value": 1
      },
      "value": 0.15
    }
  },
  "config": {
    "axis": {
      "gridColor": "#D9D9D9",
      "domainColor": "#6B7280",
      "tickColor": "#6B7280",
      "labelColor": "#444444",
      "titleColor": "#222222"
    },
    "legend": {
      "labelColor": "#444444",
      "titleColor": "#222222"
    },
    "title": {
      "color": "#222222"
    }
  }
}
